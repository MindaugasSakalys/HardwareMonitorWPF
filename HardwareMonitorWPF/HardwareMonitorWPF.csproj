<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PackageIcon>FPS Hardware Monitor Icon 128.png</PackageIcon>
    <ApplicationIcon>FPS Hardware Monitor Icon.ico</ApplicationIcon>
    <AssemblyVersion>1.0.2</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="FPS Hardware Monitor Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\Users\msaka\Desktop\FPS Hardware Monitor Icon 128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
