<Window x:Class="HardwareMonitorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Monitor" Width="440" Height="560"
        MinWidth="440" MinHeight="560" MaxWidth="440" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101419" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C232D" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#303B4A" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AEB8C7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#778394" />
        <SolidColorBrush x:Key="CardSecondaryTextBrush" Color="#AEB8C7" />
        <SolidColorBrush x:Key="CardMutedTextBrush" Color="#778394" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#42D9F5" />
        <SolidColorBrush x:Key="StatusTextBrush" Color="#55E6B0" />
        <SolidColorBrush x:Key="StatusDotBrush" Color="#55E6B0" />
        <SolidColorBrush x:Key="CpuTintBrush" Color="#243B82F6" />
        <SolidColorBrush x:Key="GpuTintBrush" Color="#2434D399" />
        <SolidColorBrush x:Key="HotSpotTintBrush" Color="#24F59E0B" />
        <SolidColorBrush x:Key="MemoryTintBrush" Color="#248B5CF6" />
        <SolidColorBrush x:Key="FpsTintBrush" Color="#2434D399" />
        <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="12" ShadowDepth="2" Opacity="0.16" />
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SensorCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CardSecondaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TemperatureStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="UnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DeviceStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CardMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>
    <Border x:Name="rootBorder" Margin="8" Padding="14" CornerRadius="26"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.20" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="110" />
                <RowDefinition Height="12" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="▣" Foreground="{DynamicResource AccentTextBrush}" FontSize="29"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hardware Monitor" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="lblVersion" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"
                               VerticalAlignment="Bottom" Margin="9,0,0,5" />
                </StackPanel>
                <Button x:Name="btnAlwaysOnTop" Grid.Column="2" Content="⌖" Click="AlwaysOnTop_Click"
                        ToolTip="Always on top" Style="{StaticResource HeaderButtonStyle}" />
                <Button x:Name="btnSettings" Grid.Column="3" Content="⚙" Click="Settings_Click"
                        ToolTip="Settings" Style="{StaticResource HeaderButtonStyle}" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SensorCardStyle}"
                        ToolTip="CPU temperature. 50–70 °C is normal while gaming; above 85 °C is too high for sustained use, and 100 °C is critical.">
                    <Grid ClipToBounds="True">
                        <Path Data="M 0,48 C 38,48 62,0 100,0 L 100,100 L 0,100 Z" Stretch="Fill"
                              Width="140" Height="55" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Fill="{DynamicResource CpuTintBrush}" IsHitTestVisible="False" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="CPU" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="▦" Foreground="#1684EA" FontSize="28" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="lblCPU" Grid.Row="1" Text="--°" Style="{StaticResource TemperatureStyle}"
                                       Foreground="#1684EA" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="C" Style="{StaticResource UnitStyle}" Foreground="#1684EA" />
                            <TextBlock x:Name="lblCPUName" Grid.Row="3" Text="Processor" Style="{StaticResource DeviceStyle}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SensorCardStyle}"
                        ToolTip="GPU Core is the temperature of the main graphics chip. 40–65 °C is excellent, 65–80 °C is normal while gaming, and above 90 °C is too hot.">
                    <Grid ClipToBounds="True">
                        <Path Data="M 0,48 C 38,48 62,0 100,0 L 100,100 L 0,100 Z" Stretch="Fill"
                              Width="140" Height="55" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Fill="{DynamicResource GpuTintBrush}" IsHitTestVisible="False" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="GPU" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="◉" Foreground="#12A050" FontSize="27" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="lblGPU" Grid.Row="1" Text="--°" Style="{StaticResource TemperatureStyle}"
                                       Foreground="#12A050" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="C" Style="{StaticResource UnitStyle}" Foreground="#12A050" />
                            <TextBlock x:Name="lblGPUName" Grid.Row="3" Text="Graphics card" Style="{StaticResource DeviceStyle}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SensorCardStyle}"
                        ToolTip="GPU Hot Spot is the temperature of the hottest point on the GPU chip. 80–95 °C is normal; above 105 °C is too hot.">
                    <Grid ClipToBounds="True">
                        <Path Data="M 0,48 C 38,48 62,0 100,0 L 100,100 L 0,100 Z" Stretch="Fill"
                              Width="140" Height="55" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Fill="{DynamicResource HotSpotTintBrush}" IsHitTestVisible="False" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="HOT SPOT" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="♨" Foreground="#F08A00" FontSize="29" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="lblHotSpot" Grid.Row="1" Text="--°" Style="{StaticResource TemperatureStyle}"
                                       Foreground="#F08A00" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="C" Style="{StaticResource UnitStyle}" Foreground="#F08A00" />
                            <TextBlock Grid.Row="3" Text="GPU Junction" Style="{StaticResource DeviceStyle}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SensorCardStyle}"
                        ToolTip="GPU Memory is the graphics card's VRAM temperature. 40–65 °C is excellent, 65–80 °C is normal, 90–100 °C is high, and above 100 °C is too hot.">
                    <Grid ClipToBounds="True">
                        <Path Data="M 0,48 C 38,48 62,0 100,0 L 100,100 L 0,100 Z" Stretch="Fill"
                              Width="140" Height="55" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Fill="{DynamicResource MemoryTintBrush}" IsHitTestVisible="False" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="VRAM" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="▤" Foreground="#8B35D6" FontSize="26" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="lblMemory" Grid.Row="1" Text="--°" Style="{StaticResource TemperatureStyle}"
                                       Foreground="#8B35D6" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="C" Style="{StaticResource UnitStyle}" Foreground="#8B35D6" />
                            <TextBlock Grid.Row="3" Text="Memory temp" Style="{StaticResource DeviceStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="4" Padding="16" CornerRadius="16" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Effect="{StaticResource CardShadowEffect}">
                <Grid ClipToBounds="True">
                    <Path Data="M 0,48 C 38,48 62,0 100,0 L 100,100 L 0,100 Z" Stretch="Fill"
                          Width="220" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Fill="{DynamicResource FpsTintBrush}" IsHitTestVisible="False" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="GAME FPS" Style="{StaticResource CaptionStyle}" FontSize="15" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Width="12" Height="12" Fill="{DynamicResource StatusDotBrush}" Margin="0,2,7,0" />
                                <TextBlock Text="Monitoring" Foreground="{DynamicResource StatusTextBrush}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="lblFPS" Text="--" Foreground="#12A050" FontSize="48" FontWeight="Bold" />
                                <TextBlock Text="FPS" Foreground="{DynamicResource CardSecondaryTextBrush}" FontSize="18"
                                           VerticalAlignment="Bottom" Margin="9,0,0,10" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Height="50" Margin="0,0,4,0">
                                <Border Width="11" Height="14" Background="#6634D399" CornerRadius="3" VerticalAlignment="Bottom" Margin="0,0,5,0" />
                                <Border Width="11" Height="25" Background="#8834D399" CornerRadius="3" VerticalAlignment="Bottom" Margin="0,0,5,0" />
                                <Border Width="11" Height="36" Background="#AA34D399" CornerRadius="3" VerticalAlignment="Bottom" Margin="0,0,5,0" />
                                <Border Width="11" Height="47" Background="#CC34D399" CornerRadius="3" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="6">
                <TextBlock x:Name="lblFooter" Text="Refresh every 1000 ms" Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="Transparent" Stroke="{DynamicResource StatusDotBrush}"
                             StrokeThickness="2" Margin="0,0,7,0" />
                    <TextBlock Text="Sensors active" Foreground="{DynamicResource StatusTextBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
